# PRODUCTION — copiar a .env en el servidor API (no versionar .env)
#
#   scp .env.production.template ubintrack-api:/home/git/backend/.env
#   # editar secretos en el server
#
# Django SECRET_KEY y hosts van en local_settings.py (ver local_settings.production.template.py).

POSTGRES_DB=ubintrack
POSTGRES_USER=ubintrack
POSTGRES_PASSWORD=change-me-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Channels / Daphne (campanita)
REDIS_URL=redis://127.0.0.1:6379/1

# Cola de generación de posiciones
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Aviso de versión nueva. El mismo valor va en el .env.production del frontend.
FRONTEND_BUILD_PUBLISH_TOKEN=

# Impresora Zebra (opcional)
ZEBRA_PRINTER_IP=change-me
ZEBRA_PRINTER_PORT=9100
