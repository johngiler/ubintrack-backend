# LOCAL — copiar a .env (no versionar .env)
# Usado por Django (local_settings) y por docker-compose (Postgres).
#
#   cp .env.local.template .env
#
# Puertos Postgres familia BCT: 5432=ubintrack, 5433=portpax, 5434=publivalla

POSTGRES_DB=ubintrack
POSTGRES_USER=ubintrack
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Channels / Daphne (campanita). Index /1 vs PortPax /0.
REDIS_URL=redis://127.0.0.1:6379/1

# Cola de generación de posiciones. /2 para no pisar PortPax ni Publivalla.
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
