[Unit]
Description=Ubintrack Celery worker
After=network.target redis-server.service postgresql.service
Wants=redis-server.service

[Service]
User=git
Group=git
WorkingDirectory=/home/git/backend
Environment="PATH=/home/git/backend/.venv/bin"
ExecStart=/home/git/backend/.venv/bin/celery -A config worker -l info --concurrency=2
Restart=always
RestartSec=5
StandardOutput=append:/var/log/celery.log
StandardError=append:/var/log/celery.log

[Install]
WantedBy=multi-user.target
