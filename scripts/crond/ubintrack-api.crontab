# Ubintrack — tareas programadas del backend (producción)
# Instalar: sudo cp scripts/crond/ubintrack-api.crontab /etc/cron.d/ubintrack-api
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Refrescar agregados del dashboard
*/15 * * * * git cd /home/git/backend && .venv/bin/python manage.py refresh_dashboard >> /home/git/backend/logs/cron-refresh-dashboard.log 2>&1

# Backup diario Postgres (descomentar cuando quieras activarlo)
# 0 3 * * * git cd /home/git/backend && ./scripts/backup_db.sh >> /home/git/backend/logs/cron-backup-db.log 2>&1
